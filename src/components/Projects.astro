---
import GitHub from "./icons/GitHub.astro"
import Python from "./icons/Python.astro"
import FastAPI from "./icons/FastAPI.astro"
import LangGraph from "./icons/LangGraph.astro"
import ChromaDB from "./icons/ChromaDB.astro"
import Docker from "./icons/Docker.astro"
import NodeJS from "./icons/NodeJS.astro"
import React from "./icons/React.astro"
import MongoDB from "./icons/MongoDB.astro"
import SocketIO from "./icons/SocketIO.astro"
import JavaScript from "./icons/JavaScript.astro"
import MachineLearning from "./icons/MachineLearning.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  PYTHON:     { name: "Python",         class: "bg-[#1e3a5f] text-yellow-300",   icon: Python },
  FASTAPI:    { name: "FastAPI",         class: "bg-[#0d3330] text-[#00d09c]",   icon: FastAPI },
  LANGGRAPH:  { name: "LangGraph",       class: "bg-[#0d2e1a] text-[#4ade80]",   icon: LangGraph },
  CHROMADB:   { name: "ChromaDB",        class: "bg-[#2d1515] text-[#ff7043]",   icon: ChromaDB },
  DOCKER:     { name: "Docker",          class: "bg-[#0d2035] text-[#2496ED]",   icon: Docker },
  NODEJS:     { name: "Node.js",         class: "bg-[#1a2e1a] text-[#68A063]",   icon: NodeJS },
  REACT:      { name: "React",           class: "bg-[#0d2535] text-[#61DAFB]",   icon: React },
  MONGODB:    { name: "MongoDB",         class: "bg-[#1a2e1a] text-[#4DB33D]",   icon: MongoDB },
  SOCKETIO:   { name: "Socket.io",       class: "bg-[#1a1a1a] text-white",        icon: SocketIO },
  JAVASCRIPT: { name: "JavaScript",      class: "bg-[#2e2a00] text-[#F7DF1E]",   icon: JavaScript },
  ML:         { name: "Machine Learning",class: "bg-[#0d2e1a] text-[#4CAF50]",   icon: MachineLearning },
}

const PROJECTS = projectsData.map((p) => ({
  ...p,
  tags: p.tags.map((key) => TAGS[key]),
}))

const FEATURED = PROJECTS.slice(0, 2)
const MORE     = PROJECTS.slice(2)
---

<div class="flex flex-col gap-y-16" id="projects-featured">
  {FEATURED.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
      <div class="w-full md:w-1/2">
        <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50">
          <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
        </div>
      </div>
      <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
        <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">{title}</h3>
        <ul class="flex flex-row flex-wrap mt-3 gap-2">
          {tags.map((tag) => (
            <li>
              <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
        <footer class="flex items-center mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-5" />
              Code
            </LinkButton>
          )}
          {link && link !== github && (
            <LinkButton href={link}>
              <ExternalLink class="size-4" />
              Preview
            </LinkButton>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>

<!-- Show More Toggle Button -->
<div class="flex justify-center mt-10">
  <button
    id="toggle-projects-btn"
    class="group flex items-center gap-2 px-6 py-3 rounded-full border border-yellow-400/40 bg-yellow-400/5 text-yellow-500 dark:text-yellow-400 text-sm font-medium hover:bg-yellow-400/10 hover:border-yellow-400/70 transition-all duration-300"
    aria-expanded="false"
    aria-controls="projects-more"
  >
    <span id="toggle-label">Show all projects</span>
    <svg
      id="toggle-chevron"
      class="size-4 transition-transform duration-300"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
</div>

<!-- Hidden additional projects -->
<div
  id="projects-more"
  class="flex flex-col gap-y-16 mt-16 overflow-hidden transition-all duration-500 ease-in-out"
  style="max-height: 0; opacity: 0;"
  aria-hidden="true"
>
  {MORE.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
      <div class="w-full md:w-1/2">
        <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(251,191,36,0.2)] lg:border lg:border-gray-800 lg:hover:border-yellow-400/30 lg:hover:bg-gray-800/50">
          <img alt={title} class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" aria-hidden="true"></div>
        </div>
      </div>
      <div class="w-full md:w-1/2 md:max-w-lg flex flex-col justify-center">
        <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">{title}</h3>
        <ul class="flex flex-row flex-wrap mt-3 gap-2">
          {tags.map((tag) => (
            <li>
              <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}>
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-gray-700 dark:text-gray-400 text-pretty">{description}</p>
        <footer class="flex items-center mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-5" />
              Code
            </LinkButton>
          )}
          {link && link !== github && (
            <LinkButton href={link}>
              <ExternalLink class="size-4" />
              Preview
            </LinkButton>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const btn      = document.getElementById("toggle-projects-btn")
    const more     = document.getElementById("projects-more")
    const label    = document.getElementById("toggle-label")
    const chevron  = document.getElementById("toggle-chevron")

    if (!btn || !more || !label || !chevron) return

    let open = false

    btn.addEventListener("click", () => {
      open = !open

      if (open) {
        // Expand: measure natural height, animate to it
        more.style.maxHeight  = more.scrollHeight + "px"
        more.style.opacity    = "1"
        more.setAttribute("aria-hidden", "false")
        btn.setAttribute("aria-expanded", "true")
        label.textContent     = "Show fewer projects"
        chevron.style.transform = "rotate(180deg)"
      } else {
        // Collapse
        more.style.maxHeight  = "0"
        more.style.opacity    = "0"
        more.setAttribute("aria-hidden", "true")
        btn.setAttribute("aria-expanded", "false")
        label.textContent     = "Show all projects"
        chevron.style.transform = "rotate(0deg)"
        // Scroll back up to the projects section smoothly
        document.getElementById("projects-featured")
          ?.scrollIntoView({ behavior: "smooth", block: "start" })
      }
    })
  })
</script>

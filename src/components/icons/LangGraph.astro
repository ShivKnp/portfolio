---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <!-- LangGraph node graph icon -->
  <circle cx="4" cy="12" r="3" fill="#1C7C54"/>
  <circle cx="20" cy="5" r="3" fill="#1C7C54"/>
  <circle cx="20" cy="19" r="3" fill="#1C7C54"/>
  <circle cx="12" cy="12" r="3" fill="#4CAF50"/>
  <line x1="7" y1="12" x2="9" y2="12" stroke="#4CAF50" stroke-width="1.5"/>
  <line x1="14.5" y1="10.5" x2="17.5" y2="7" stroke="#4CAF50" stroke-width="1.5"/>
  <line x1="14.5" y1="13.5" x2="17.5" y2="17" stroke="#4CAF50" stroke-width="1.5"/>
</svg>
